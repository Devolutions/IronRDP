{
  "type": "object",
  "additionalProperties": false,
  "required": ["head_sha", "reviewer", "summary", "findings"],
  "properties": {
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewer": { "enum": ["protocol", "skeptical", "code-compressor"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "severity",
          "path",
          "start_line",
          "end_line",
          "title",
          "rationale",
          "confidence",
          "references"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "question": { "type": "boolean" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "start_line": { "type": ["integer", "null"], "minimum": 1 },
          "end_line": { "type": ["integer", "null"], "minimum": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "references": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["protocol_id", "section", "heading"],
              "properties": {
                "protocol_id": { "type": "string", "pattern": "^(?:MS|MC)-[A-Z0-9]+$" },
                "section": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
                "heading": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "start_line": { "type": "null" } },
              "required": ["start_line"]
            },
            "then": { "properties": { "end_line": { "type": "null" } } },
            "else": { "properties": { "end_line": { "type": "integer", "minimum": 1 } } }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewer": { "enum": ["skeptical", "code-compressor"] }
        },
        "required": ["reviewer"]
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "references": { "maxItems": 0 }
              }
            }
          }
        }
      }
    }
  ]
}
