diff --git a/libcef/browser/isolated_clipboard.cc b/libcef/browser/isolated_clipboard.cc
new file mode 100644
index 000000000..f6bd418e0
--- /dev/null
+++ b/libcef/browser/isolated_clipboard.cc
@@ -0,0 +1,192 @@
+// Copyright (c) 2026 The Chromium Embedded Framework Authors. All rights
+// reserved. Use of this source code is governed by a BSD-style license that
+// can be found in the LICENSE file.
+
+#include "cef/libcef/browser/isolated_clipboard.h"
+
+#include <algorithm>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "components/headless/clipboard/headless_clipboard.h"
+#include "content/public/browser/browser_thread.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/base/clipboard/clipboard.h"
+#include "ui/base/clipboard/clipboard_buffer.h"
+#include "ui/base/clipboard/clipboard_data.h"
+#include "ui/base/clipboard/clipboard_non_backed.h"
+#include "ui/base/clipboard/clipboard_sequence_number_token.h"
+#include "ui/gfx/codec/png_codec.h"
+
+namespace isolated_clipboard {
+
+namespace {
+
+bool g_installed = false;
+
+struct GenerationState {
+  std::optional<ui::ClipboardSequenceNumberToken> token;
+  int64_t generation = 0;
+};
+
+GenerationState& generation_state() {
+  static GenerationState state;
+  return state;
+}
+
+ui::ClipboardNonBacked* GetClipboard() {
+  if (!g_installed ||
+      !content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    return nullptr;
+  }
+  return ui::ClipboardNonBacked::GetForCurrentThread();
+}
+
+bool HasFormat(const ui::ClipboardData& data,
+               ui::ClipboardInternalFormat format) {
+  return (data.format() & static_cast<int>(format)) != 0;
+}
+
+int64_t CopyOut(const uint8_t* bytes,
+                size_t length,
+                uint8_t* buffer,
+                size_t capacity) {
+  if (buffer && capacity > 0) {
+    std::copy_n(bytes, std::min(length, capacity), buffer);
+  }
+  return static_cast<int64_t>(length);
+}
+
+}  // namespace
+
+void InstallIfRequested() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(kSwitch)) {
+    return;
+  }
+  // A clipboard created earlier would keep serving the platform clipboard,
+  // and SetClipboardForCurrentThread only DCHECKs against replacing it.
+  CHECK(!ui::Clipboard::TakeForCurrentThread())
+      << "a platform clipboard was created before the isolated clipboard";
+  headless::SetHeadlessClipboardForCurrentThread();
+  g_installed = true;
+}
+
+}  // namespace isolated_clipboard
+
+using isolated_clipboard::CopyOut;
+using isolated_clipboard::GetClipboard;
+using isolated_clipboard::HasFormat;
+
+int cef_isolated_clipboard_enabled(void) {
+  return GetClipboard() ? 1 : 0;
+}
+
+int64_t cef_isolated_clipboard_generation(void) {
+  ui::ClipboardNonBacked* clipboard = GetClipboard();
+  if (!clipboard) {
+    return CEF_ISOLATED_CLIPBOARD_WRONG_STATE;
+  }
+  auto& state = isolated_clipboard::generation_state();
+  const auto& token =
+      clipboard->GetSequenceNumber(ui::ClipboardBuffer::kCopyPaste);
+  if (state.token != token) {
+    state.token = token;
+    ++state.generation;
+  }
+  return state.generation;
+}
+
+int64_t cef_isolated_clipboard_read(int kind,
+                                    uint8_t* buffer,
+                                    size_t capacity) {
+  ui::ClipboardNonBacked* clipboard = GetClipboard();
+  if (!clipboard) {
+    return CEF_ISOLATED_CLIPBOARD_WRONG_STATE;
+  }
+  if (!buffer && capacity > 0) {
+    return CEF_ISOLATED_CLIPBOARD_INVALID;
+  }
+  const ui::ClipboardData* data =
+      clipboard->GetClipboardData(nullptr, ui::ClipboardBuffer::kCopyPaste);
+  if (!data) {
+    return CEF_ISOLATED_CLIPBOARD_ABSENT;
+  }
+
+  switch (kind) {
+    case CEF_ISOLATED_CLIPBOARD_TEXT: {
+      if (!HasFormat(*data, ui::ClipboardInternalFormat::kText)) {
+        return CEF_ISOLATED_CLIPBOARD_ABSENT;
+      }
+      const std::string& text = data->text();
+      return CopyOut(reinterpret_cast<const uint8_t*>(text.data()), text.size(),
+                     buffer, capacity);
+    }
+    case CEF_ISOLATED_CLIPBOARD_HTML: {
+      if (!HasFormat(*data, ui::ClipboardInternalFormat::kHtml)) {
+        return CEF_ISOLATED_CLIPBOARD_ABSENT;
+      }
+      const std::string& markup = data->markup_data();
+      return CopyOut(reinterpret_cast<const uint8_t*>(markup.data()),
+                     markup.size(), buffer, capacity);
+    }
+    case CEF_ISOLATED_CLIPBOARD_PNG: {
+      if (!HasFormat(*data, ui::ClipboardInternalFormat::kPng)) {
+        return CEF_ISOLATED_CLIPBOARD_ABSENT;
+      }
+      if (!data->maybe_png()) {
+        std::optional<SkBitmap> bitmap = data->GetBitmapIfPngNotEncoded();
+        if (!bitmap) {
+          return CEF_ISOLATED_CLIPBOARD_ABSENT;
+        }
+        std::optional<std::vector<uint8_t>> png =
+            gfx::PNGCodec::EncodeBGRASkBitmap(*bitmap,
+                                              /*discard_transparency=*/false);
+        if (!png) {
+          return CEF_ISOLATED_CLIPBOARD_ABSENT;
+        }
+        data->SetPngDataAfterEncoding(std::move(*png));
+      }
+      const std::vector<uint8_t>& png = *data->maybe_png();
+      return CopyOut(png.data(), png.size(), buffer, capacity);
+    }
+    default:
+      return CEF_ISOLATED_CLIPBOARD_INVALID;
+  }
+}
+
+int cef_isolated_clipboard_write(const uint8_t* text,
+                                 size_t text_length,
+                                 const uint8_t* html,
+                                 size_t html_length,
+                                 const uint8_t* png,
+                                 size_t png_length) {
+  ui::ClipboardNonBacked* clipboard = GetClipboard();
+  if (!clipboard) {
+    return CEF_ISOLATED_CLIPBOARD_WRONG_STATE;
+  }
+  if ((!text && text_length > 0) || (!html && html_length > 0) ||
+      (!png && png_length > 0)) {
+    return CEF_ISOLATED_CLIPBOARD_INVALID;
+  }
+
+  auto data = std::make_unique<ui::ClipboardData>();
+  if (text) {
+    data->set_text(
+        std::string(reinterpret_cast<const char*>(text), text_length));
+  }
+  if (html) {
+    data->set_markup_data(
+        std::string(reinterpret_cast<const char*>(html), html_length));
+  }
+  if (png) {
+    data->SetPngData(std::vector<uint8_t>(png, png + png_length));
+  }
+  clipboard->WriteClipboardData(std::move(data),
+                                ui::ClipboardBuffer::kCopyPaste);
+  return 0;
+}
