+// Copyright (c) 2026 The Chromium Embedded Framework Authors. All rights
+// reserved. Use of this source code is governed by a BSD-style license that
+// can be found in the LICENSE file.
+
+#ifndef CEF_LIBCEF_BROWSER_ISOLATED_CLIPBOARD_H_
+#define CEF_LIBCEF_BROWSER_ISOLATED_CLIPBOARD_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "cef/include/internal/cef_export.h"
+
+// Process-private clipboard for embedders that must never read or write the
+// host clipboard, such as remote browser isolation servers.
+//
+// Launch the browser process with --isolated-clipboard to replace the
+// platform clipboard with an in-memory clipboard before any clipboard use.
+// The embedder exchanges clipboard content through the C functions below,
+// which must be called on the browser UI thread after CefInitialize.
+
+namespace isolated_clipboard {
+
+inline constexpr char kSwitch[] = "isolated-clipboard";
+
+// Installs the in-memory clipboard when kSwitch is present. Crashes if a
+// platform clipboard already exists, because isolation would silently fail.
+void InstallIfRequested();
+
+}  // namespace isolated_clipboard
+
+extern "C" {
+
+// Content kinds for cef_isolated_clipboard_read.
+#define CEF_ISOLATED_CLIPBOARD_TEXT 0  // UTF-8 plain text.
+#define CEF_ISOLATED_CLIPBOARD_HTML 1  // UTF-8 HTML markup fragment.
+#define CEF_ISOLATED_CLIPBOARD_PNG 2   // PNG-encoded image.
+
+// Return values below zero.
+#define CEF_ISOLATED_CLIPBOARD_ABSENT -1       // No content of that kind.
+#define CEF_ISOLATED_CLIPBOARD_WRONG_STATE -2  // Disabled or not UI thread.
+#define CEF_ISOLATED_CLIPBOARD_INVALID -3      // Invalid argument.
+
+// Returns 1 when the in-memory clipboard is installed, 0 otherwise.
+CEF_EXPORT int cef_isolated_clipboard_enabled(void);
+
+// Returns a counter that increases whenever the clipboard content changes,
+// including changes made by cef_isolated_clipboard_write, or a negative
+// error.
+CEF_EXPORT int64_t cef_isolated_clipboard_generation(void);
+
+// Copies up to |capacity| bytes of |kind| content into |buffer| and returns
+// the full content length, or a negative value. Call with a null |buffer|
+// and zero |capacity| to query the length.
+CEF_EXPORT int64_t cef_isolated_clipboard_read(int kind,
+                                               uint8_t* buffer,
+                                               size_t capacity);
+
+// Replaces the clipboard content with the given representations of one item.
+// Null pointers omit a representation; all null clears the clipboard.
+// Returns 0 on success or a negative error.
+CEF_EXPORT int cef_isolated_clipboard_write(const uint8_t* text,
+                                            size_t text_length,
+                                            const uint8_t* html,
+                                            size_t html_length,
+                                            const uint8_t* png,
+                                            size_t png_length);
+
+}  // extern "C"
+
+#endif  // CEF_LIBCEF_BROWSER_ISOLATED_CLIPBOARD_H_
