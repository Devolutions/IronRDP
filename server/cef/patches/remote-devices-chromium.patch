+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_AUDIO_REMOTE_AUDIO_SOURCE_H_
+#define MEDIA_AUDIO_REMOTE_AUDIO_SOURCE_H_
+
+#include <stdint.h>
+
+#include <memory>
+
+#include "base/containers/span.h"
+#include "media/audio/audio_io.h"
+#include "media/base/audio_parameters.h"
+#include "media/base/media_export.h"
+
+namespace media {
+
+// Microphone audio supplied by the embedder, for example from a remote desktop
+// client. Fake audio input streams read it instead of a beep when the browser
+// runs with switches::kRemoteMediaCapture and
+// switches::kUseFakeDeviceForMediaStream. The audio service must run in the
+// browser process so that the embedder and the streams share this state.
+class MEDIA_EXPORT RemoteAudioSource
+    : public AudioOutputStream::AudioSourceCallback {
+ public:
+  // Rejected arguments for Push().
+  static constexpr int kInvalidArgument = -1;
+
+  explicit RemoteAudioSource(const AudioParameters& params);
+  RemoteAudioSource(const RemoteAudioSource&) = delete;
+  RemoteAudioSource& operator=(const RemoteAudioSource&) = delete;
+  ~RemoteAudioSource() override;
+
+  // Appends interleaved signed 16-bit samples for every open stream. A change
+  // of `channels` or `sample_rate` discards audio not yet read. Audio older
+  // than one second is dropped. Returns 0 or kInvalidArgument. Thread-safe.
+  static int Push(base::span<const int16_t> samples,
+                  int channels,
+                  int sample_rate);
+
+  // Returns the number of open streams reading remote audio. Thread-safe.
+  static int ActiveStreams();
+
+  // AudioOutputStream::AudioSourceCallback:
+  int OnMoreData(base::TimeDelta delay,
+                 base::TimeTicks delay_timestamp,
+                 const AudioGlitchInfo& glitch_info,
+                 AudioBus* dest) override;
+  void OnError(ErrorType type) override;
+
+ private:
+  const AudioParameters params_;
+  // Position in input frames since the current format began, or negative
+  // before the first read.
+  double position_ = -1;
+  uint64_t format_generation_ = 0;
+};
+
+}  // namespace media
+
+#endif  // MEDIA_AUDIO_REMOTE_AUDIO_SOURCE_H_
