+// found in the LICENSE file.
+
+#ifndef MEDIA_CAPTURE_VIDEO_REMOTE_VIDEO_CAPTURE_DEVICE_H_
+#define MEDIA_CAPTURE_VIDEO_REMOTE_VIDEO_CAPTURE_DEVICE_H_
+
+#include <stdint.h>
+
+#include <memory>
+
+#include "base/containers/span.h"
+#include "base/threading/thread_checker.h"
+#include "base/time/time.h"
+#include "media/base/video_types.h"
+#include "media/capture/capture_export.h"
+#include "media/capture/video/video_capture_device.h"
+#include "media/capture/video/video_capture_device_factory.h"
+#include "media/capture/video_capture_types.h"
+
+namespace media {
+
+// Camera frames supplied by the embedder, for example from a remote desktop
+// client. Used instead of the fake camera when the browser runs with
+// switches::kRemoteMediaCapture and switches::kUseFakeDeviceForMediaStream.
+// The video capture service must run in the browser process so that the
+// embedder and the device share this state.
+class CAPTURE_EXPORT RemoteVideoCaptureDevice : public VideoCaptureDevice {
+ public:
+  enum PushResult {
+    kDelivered = 0,
+    kNoConsumer = 1,
+    kInvalidArgument = -1,
+  };
+
+  RemoteVideoCaptureDevice();
+  RemoteVideoCaptureDevice(const RemoteVideoCaptureDevice&) = delete;
+  RemoteVideoCaptureDevice& operator=(const RemoteVideoCaptureDevice&) = delete;
+  ~RemoteVideoCaptureDevice() override;
+
+  // Delivers one frame to the capturing page. `format` is one of
+  // PIXEL_FORMAT_I420, PIXEL_FORMAT_NV12, PIXEL_FORMAT_YUY2, PIXEL_FORMAT_ARGB
+  // (BGRA in memory) or PIXEL_FORMAT_MJPEG. Thread-safe.
+  static PushResult PushFrame(VideoPixelFormat format,
+                              int width,
+                              int height,
+                              base::span<const uint8_t> data,
+                              base::TimeDelta timestamp);
+
+  // Returns the format requested by the capturing page, or nullopt when no
+  // page is capturing. Thread-safe.
+  static std::optional<VideoCaptureFormat> RequestedFormat();
+
+  // VideoCaptureDevice:
+  void AllocateAndStart(const VideoCaptureParams& params,
+                        std::unique_ptr<Client> client) override;
+  void StopAndDeAllocate() override;
+  void InvalidateBuffers() override;
+};
+
+class CAPTURE_EXPORT RemoteVideoCaptureDeviceFactory
+    : public VideoCaptureDeviceFactory {
+ public:
+  static constexpr char kDeviceId[] = "remote-camera";
+
+  RemoteVideoCaptureDeviceFactory();
+  ~RemoteVideoCaptureDeviceFactory() override;
+
+  // VideoCaptureDeviceFactory:
+  VideoCaptureErrorOrDevice CreateDevice(
+      const VideoCaptureDeviceDescriptor& device_descriptor) override;
+  void GetDevicesInfo(GetDevicesInfoCallback callback) override;
+
+ private:
+  THREAD_CHECKER(thread_checker_);
+};
+
+}  // namespace media
+
+#endif  // MEDIA_CAPTURE_VIDEO_REMOTE_VIDEO_CAPTURE_DEVICE_H_
