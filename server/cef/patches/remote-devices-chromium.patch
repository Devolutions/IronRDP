@@ -0,0 +1,62 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_PUBLIC_BROWSER_REMOTE_WEBAUTHN_H_
+#define CONTENT_PUBLIC_BROWSER_REMOTE_WEBAUTHN_H_
+
+#include <stdint.h>
+
+#include <vector>
+
+#include "base/functional/callback_forward.h"
+#include "content/common/content_export.h"
+
+namespace content {
+
+// Command-line switch that sends every Web Authentication request to one
+// authenticator implemented by the embedder, for example a security key or
+// platform authenticator on a remote desktop client. Browser UI, platform
+// authenticators, security keys attached to this host and hybrid transport are
+// not used.
+CONTENT_EXPORT extern const char kRemoteWebAuthnSwitch[];
+
+// Receives a CTAP2 request: the command byte followed by its CBOR parameters.
+// The embedder answers with RespondToRemoteWebAuthnRequest() using the same
+// `request_id`, possibly after waiting for the user.
+using RemoteWebAuthnRequestCallback =
+    base::RepeatingCallback<void(uint64_t request_id,
+                                 std::vector<uint8_t> request)>;
+// Asks the embedder to abandon `request_id`. The embedder should still answer
+// with CTAP2_ERR_KEEPALIVE_CANCEL, or not at all.
+using RemoteWebAuthnCancelCallback =
+    base::RepeatingCallback<void(uint64_t request_id)>;
+
+// Returns whether the browser runs with kRemoteWebAuthnSwitch.
+CONTENT_EXPORT bool IsRemoteWebAuthnEnabled();
+
+// The functions below must be called on the UI thread.
+
+// Installs the embedder authenticator. Requests made without a handler fail as
+// if no authenticator answered. Passing null callbacks removes the handler and
+// fails pending requests.
+CONTENT_EXPORT void SetRemoteWebAuthnHandler(
+    RemoteWebAuthnRequestCallback request_callback,
+    RemoteWebAuthnCancelCallback cancel_callback);
+
+// Completes `request_id` with a CTAP2 response: the status byte followed by
+// its CBOR payload. An empty response fails the request. Returns false when
+// the request is unknown, for example because it was already cancelled.
+CONTENT_EXPORT bool RespondToRemoteWebAuthnRequest(
+    uint64_t request_id,
+    std::vector<uint8_t> response);
+
+// Sets the value reported by
+// PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable(), which
+// is false until set.
+CONTENT_EXPORT void SetRemoteWebAuthnPlatformAuthenticatorAvailable(
+    bool available);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_REMOTE_WEBAUTHN_H_
