diff --git a/media/audio/remote_audio_source.cc b/media/audio/remote_audio_source.cc
new file mode 100644
index 0000000000..24f561bd22
--- /dev/null
+++ b/media/audio/remote_audio_source.cc
@@ -0,0 +1,165 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/audio/remote_audio_source.h"
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "media/base/audio_bus.h"
+
+namespace media {
+
+namespace {
+
+constexpr int kMaxChannels = 8;
+constexpr int kMinSampleRate = 8000;
+constexpr int kMaxSampleRate = 192000;
+// Readers further behind than this skip ahead, so latency stays bounded when
+// the client produces audio slightly faster than the stream consumes it.
+constexpr double kMaxLatencySeconds = 0.2;
+
+struct SharedAudio {
+  base::Lock lock;
+  int channels = 0;
+  int sample_rate = 0;
+  uint64_t generation = 0;
+  // One second of interleaved samples, indexed by absolute frame modulo
+  // capacity.
+  std::vector<float> ring;
+  int64_t capacity_frames = 0;
+  // Frames pushed since the current format began.
+  int64_t written_frames = 0;
+  int active_streams = 0;
+};
+
+SharedAudio& shared() {
+  static base::NoDestructor<SharedAudio> audio;
+  return *audio;
+}
+
+float SampleAt(const SharedAudio& audio, int64_t frame, int channel) {
+  const int64_t slot = frame % audio.capacity_frames;
+  return audio.ring[static_cast<size_t>(slot * audio.channels + channel)];
+}
+
+// Mixes or duplicates input channels so any input layout fills any output.
+float MappedSample(const SharedAudio& audio,
+                   int64_t frame,
+                   int output_channel,
+                   int output_channels) {
+  if (output_channels == 1 && audio.channels > 1) {
+    float sum = 0;
+    for (int channel = 0; channel < audio.channels; ++channel) {
+      sum += SampleAt(audio, frame, channel);
+    }
+    return sum / audio.channels;
+  }
+  return SampleAt(audio, frame, std::min(output_channel, audio.channels - 1));
+}
+
+}  // namespace
+
+RemoteAudioSource::RemoteAudioSource(const AudioParameters& params)
+    : params_(params) {
+  SharedAudio& audio = shared();
+  base::AutoLock lock(audio.lock);
+  ++audio.active_streams;
+}
+
+RemoteAudioSource::~RemoteAudioSource() {
+  SharedAudio& audio = shared();
+  base::AutoLock lock(audio.lock);
+  --audio.active_streams;
+}
+
+// static
+int RemoteAudioSource::Push(base::span<const int16_t> samples,
+                            int channels,
+                            int sample_rate) {
+  if (channels < 1 || channels > kMaxChannels || sample_rate < kMinSampleRate ||
+      sample_rate > kMaxSampleRate ||
+      samples.size() % static_cast<size_t>(channels) != 0) {
+    return kInvalidArgument;
+  }
+  SharedAudio& audio = shared();
+  base::AutoLock lock(audio.lock);
+  if (audio.channels != channels || audio.sample_rate != sample_rate) {
+    audio.channels = channels;
+    audio.sample_rate = sample_rate;
+    audio.capacity_frames = sample_rate;
+    audio.ring.assign(static_cast<size_t>(sample_rate * channels), 0.0f);
+    audio.written_frames = 0;
+    ++audio.generation;
+  }
+  const size_t frames = samples.size() / static_cast<size_t>(channels);
+  for (size_t frame = 0; frame < frames; ++frame) {
+    const int64_t slot = audio.written_frames % audio.capacity_frames;
+    for (int channel = 0; channel < channels; ++channel) {
+      audio.ring[static_cast<size_t>(slot * channels + channel)] =
+          samples[frame * static_cast<size_t>(channels) +
+                  static_cast<size_t>(channel)] /
+          32768.0f;
+    }
+    ++audio.written_frames;
+  }
+  return 0;
+}
+
+// static
+int RemoteAudioSource::ActiveStreams() {
+  SharedAudio& audio = shared();
+  base::AutoLock lock(audio.lock);
+  return audio.active_streams;
+}
+
+int RemoteAudioSource::OnMoreData(base::TimeDelta delay,
+                                  base::TimeTicks delay_timestamp,
+                                  const AudioGlitchInfo& glitch_info,
+                                  AudioBus* dest) {
+  dest->Zero();
+  SharedAudio& audio = shared();
+  base::AutoLock lock(audio.lock);
+  if (audio.channels == 0) {
+    return dest->frames();
+  }
+  const double written = static_cast<double>(audio.written_frames);
+  if (format_generation_ != audio.generation || position_ < 0) {
+    format_generation_ = audio.generation;
+    position_ = written;
+  }
+  const double max_latency = kMaxLatencySeconds * audio.sample_rate;
+  if (written - position_ > max_latency) {
+    position_ = written - max_latency / 4;
+  }
+
+  const double step =
+      static_cast<double>(audio.sample_rate) / params_.sample_rate();
+  int produced = 0;
+  for (; produced < dest->frames(); ++produced) {
+    const double position = position_ + produced * step;
+    const int64_t frame = static_cast<int64_t>(std::floor(position));
+    // Interpolation reads the next frame, which must already be written.
+    if (frame + 1 >= audio.written_frames) {
+      break;
+    }
+    const float fraction = static_cast<float>(position - frame);
+    for (int channel = 0; channel < dest->channels(); ++channel) {
+      const float first = MappedSample(audio, frame, channel, dest->channels());
+      const float second =
+          MappedSample(audio, frame + 1, channel, dest->channels());
+      dest->channel(channel)[static_cast<size_t>(produced)] =
+          first + (second - first) * fraction;
+    }
+  }
+  position_ += produced * step;
+  return dest->frames();
+}
+
+void RemoteAudioSource::OnError(ErrorType type) {}
+
+}  // namespace media
