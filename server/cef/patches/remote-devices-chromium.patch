+
+#ifndef CONTENT_BROWSER_WEBAUTH_REMOTE_AUTHENTICATOR_H_
+#define CONTENT_BROWSER_WEBAUTH_REMOTE_AUTHENTICATOR_H_
+
+#include <memory>
+
+#include "content/public/browser/remote_webauthn.h"
+
+namespace device {
+class FidoDiscoveryFactory;
+}
+
+namespace content {
+
+class AuthenticatorRequestClientDelegate;
+
+// Discovers only the embedder authenticator installed with
+// SetRemoteWebAuthnHandler().
+std::unique_ptr<device::FidoDiscoveryFactory> MakeRemoteFidoDiscoveryFactory();
+
+// Attaches the current WebAuthn ceremony's metadata to `factory` when it was
+// created by MakeRemoteFidoDiscoveryFactory().
+void SetRemoteDiscoveryMetadata(device::FidoDiscoveryFactory* factory,
+                                RemoteWebAuthnRequest metadata);
+
+// A request delegate without browser UI, which dispatches requests to the
+// embedder authenticator as soon as it is discovered.
+std::unique_ptr<AuthenticatorRequestClientDelegate>
+MakeRemoteAuthenticatorRequestDelegate();
+
+bool IsRemoteWebAuthnPlatformAuthenticatorAvailable();
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_WEBAUTH_REMOTE_AUTHENTICATOR_H_
