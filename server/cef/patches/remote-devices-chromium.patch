diff --git a/media/capture/video/remote_video_capture_device.cc b/media/capture/video/remote_video_capture_device.cc
new file mode 100644
index 0000000000..1567aec08e
--- /dev/null
+++ b/media/capture/video/remote_video_capture_device.cc
@@ -0,0 +1,190 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/capture/video/remote_video_capture_device.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "base/thread_annotations.h"
+#include "build/build_config.h"
+#include "media/base/video_frame.h"
+#include "ui/gfx/color_space.h"
+
+namespace media {
+
+namespace {
+
+constexpr int kMaxDimension = 4096;
+constexpr float kFrameRate = 30.0f;
+
+struct ActiveCapture {
+  base::Lock lock;
+  // The started device, or null. Only that device may clear the capture, so a
+  // late stop of a replaced device cannot detach its successor.
+  raw_ptr<const RemoteVideoCaptureDevice> owner GUARDED_BY(lock) = nullptr;
+  std::unique_ptr<VideoCaptureDevice::Client> client GUARDED_BY(lock);
+  VideoCaptureFormat requested_format GUARDED_BY(lock);
+  base::TimeTicks first_frame_time GUARDED_BY(lock);
+};
+
+ActiveCapture& active_capture() {
+  static base::NoDestructor<ActiveCapture> capture;
+  return *capture;
+}
+
+bool IsSupportedFormat(VideoPixelFormat format) {
+  switch (format) {
+    case PIXEL_FORMAT_I420:
+    case PIXEL_FORMAT_NV12:
+    case PIXEL_FORMAT_YUY2:
+    case PIXEL_FORMAT_ARGB:
+    case PIXEL_FORMAT_MJPEG:
+      return true;
+    default:
+      return false;
+  }
+}
+
+VideoCaptureApi PlatformCaptureApi() {
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  return VideoCaptureApi::LINUX_V4L2_SINGLE_PLANE;
+#elif BUILDFLAG(IS_MAC)
+  return VideoCaptureApi::MACOSX_AVFOUNDATION;
+#elif BUILDFLAG(IS_WIN)
+  return VideoCaptureApi::WIN_DIRECT_SHOW;
+#else
+  return VideoCaptureApi::UNKNOWN;
+#endif
+}
+
+}  // namespace
+
+RemoteVideoCaptureDevice::RemoteVideoCaptureDevice() = default;
+
+RemoteVideoCaptureDevice::~RemoteVideoCaptureDevice() {
+  StopAndDeAllocate();
+}
+
+// static
+RemoteVideoCaptureDevice::PushResult RemoteVideoCaptureDevice::PushFrame(
+    VideoPixelFormat format,
+    int width,
+    int height,
+    base::span<const uint8_t> data,
+    base::TimeDelta timestamp) {
+  if (!IsSupportedFormat(format) || width <= 0 || height <= 0 ||
+      width > kMaxDimension || height > kMaxDimension || data.empty()) {
+    return kInvalidArgument;
+  }
+  const gfx::Size size(width, height);
+  if (format != PIXEL_FORMAT_MJPEG &&
+      data.size() != VideoFrame::AllocationSize(format, size)) {
+    return kInvalidArgument;
+  }
+
+  ActiveCapture& capture = active_capture();
+  base::AutoLock lock(capture.lock);
+  if (!capture.client) {
+    return kNoConsumer;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (capture.first_frame_time.is_null()) {
+    capture.first_frame_time = now;
+  }
+  const VideoCaptureFormat frame_format(size, kFrameRate, format);
+  // Clients accept frames from any thread as long as calls do not overlap,
+  // which the lock guarantees.
+  capture.client->OnIncomingCapturedData(
+      data, frame_format, gfx::ColorSpace::CreateREC709(),
+      /*clockwise_rotation=*/0, /*flip_y=*/false, now,
+      timestamp.is_zero() ? now - capture.first_frame_time : timestamp,
+      /*capture_begin_timestamp=*/std::nullopt, /*metadata=*/std::nullopt);
+  return kDelivered;
+}
+
+// static
+std::optional<VideoCaptureFormat> RemoteVideoCaptureDevice::RequestedFormat() {
+  ActiveCapture& capture = active_capture();
+  base::AutoLock lock(capture.lock);
+  if (!capture.client) {
+    return std::nullopt;
+  }
+  return capture.requested_format;
+}
+
+void RemoteVideoCaptureDevice::AllocateAndStart(
+    const VideoCaptureParams& params,
+    std::unique_ptr<Client> client) {
+  Client* started_client = client.get();
+  {
+    ActiveCapture& capture = active_capture();
+    base::AutoLock lock(capture.lock);
+    capture.owner = this;
+    capture.client = std::move(client);
+    capture.requested_format = params.requested_format;
+    capture.first_frame_time = base::TimeTicks();
+  }
+  // OnStarted() must not run under the lock, because it may synchronously
+  // reach code that pushes frames.
+  started_client->OnStarted();
+}
+
+void RemoteVideoCaptureDevice::StopAndDeAllocate() {
+  std::unique_ptr<Client> client;
+  {
+    ActiveCapture& capture = active_capture();
+    base::AutoLock lock(capture.lock);
+    if (capture.owner != this) {
+      return;
+    }
+    capture.owner = nullptr;
+    client = std::move(capture.client);
+  }
+}
+
+void RemoteVideoCaptureDevice::InvalidateBuffers() {
+  ActiveCapture& capture = active_capture();
+  base::AutoLock lock(capture.lock);
+  if (capture.owner == this && capture.client) {
+    capture.client->InvalidateBuffers();
+  }
+}
+
+RemoteVideoCaptureDeviceFactory::RemoteVideoCaptureDeviceFactory() = default;
+
+RemoteVideoCaptureDeviceFactory::~RemoteVideoCaptureDeviceFactory() = default;
+
+VideoCaptureErrorOrDevice RemoteVideoCaptureDeviceFactory::CreateDevice(
+    const VideoCaptureDeviceDescriptor& device_descriptor) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (device_descriptor.device_id != kDeviceId) {
+    return VideoCaptureErrorOrDevice(
+        VideoCaptureError::
+            kVideoCaptureControllerInvalidOrUnsupportedVideoCaptureParametersRequested);
+  }
+  return VideoCaptureErrorOrDevice(
+      std::make_unique<RemoteVideoCaptureDevice>());
+}
+
+void RemoteVideoCaptureDeviceFactory::GetDevicesInfo(
+    GetDevicesInfoCallback callback) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  VideoCaptureDeviceInfo info(VideoCaptureDeviceDescriptor(
+      "Remote camera", kDeviceId, /*model_id=*/std::string(),
+      PlatformCaptureApi(), VideoCaptureControlSupport(),
+      VideoCaptureTransportType::OTHER_TRANSPORT,
+      VideoFacingMode::MEDIA_VIDEO_FACING_USER));
+  for (const gfx::Size& size :
+       {gfx::Size(640, 480), gfx::Size(1280, 720), gfx::Size(1920, 1080)}) {
+    info.supported_formats.emplace_back(size, kFrameRate, PIXEL_FORMAT_I420);
+  }
+  std::vector<VideoCaptureDeviceInfo> devices;
+  devices.push_back(std::move(info));
+  std::move(callback).Run(std::move(devices));
+}
+
+}  // namespace media
