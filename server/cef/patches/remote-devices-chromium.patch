--- /dev/null
+++ b/content/browser/webauth/remote_authenticator.cc
@@ -0,0 +1,302 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/webauth/remote_authenticator.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/containers/flat_map.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/location.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/task/single_thread_task_runner.h"
+#include "build/build_config.h"
+#include "content/public/browser/authenticator_request_client_delegate.h"
+#include "content/public/browser/browser_thread.h"
+#include "device/fido/authenticator_get_assertion_response.h"
+#include "device/fido/authenticator_supported_options.h"
+#include "device/fido/fido_device.h"
+#include "device/fido/fido_device_authenticator.h"
+#include "device/fido/fido_device_discovery.h"
+#include "device/fido/fido_discovery_factory.h"
+#include "device/fido/fido_request_handler_base.h"
+#include "device/fido/public/fido_transport_protocol.h"
+
+namespace content {
+
+const char kRemoteWebAuthnSwitch[] = "remote-webauthn";
+
+namespace {
+
+class RemoteFidoDevice;
+
+struct RemoteWebAuthnState {
+  RemoteWebAuthnRequestCallback request_callback;
+  RemoteWebAuthnCancelCallback cancel_callback;
+  bool platform_authenticator_available = false;
+  uint64_t next_request_id = 1;
+  base::flat_map<uint64_t, base::WeakPtr<RemoteFidoDevice>> pending;
+};
+
+RemoteWebAuthnState& GetState() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  static base::NoDestructor<RemoteWebAuthnState> state;
+  return *state;
+}
+
+// Forwards CTAP2 messages to the embedder. Requests stay pending until the
+// embedder responds, the device cancels them, or the device is destroyed when
+// the WebAuthn request ends.
+class RemoteFidoDevice final : public device::FidoDevice {
+ public:
+  explicit RemoteFidoDevice(device::FidoTransportProtocol transport)
+      : transport_(transport) {}
+
+  RemoteFidoDevice(const RemoteFidoDevice&) = delete;
+  RemoteFidoDevice& operator=(const RemoteFidoDevice&) = delete;
+
+  ~RemoteFidoDevice() override {
+    RemoteWebAuthnState& state = GetState();
+    for (const auto& [request_id, request] : requests_) {
+      state.pending.erase(request_id);
+      if (state.cancel_callback) {
+        state.cancel_callback.Run(request_id);
+      }
+    }
+  }
+
+  // Runs the transaction callback, which may destroy this device.
+  void Complete(uint64_t request_id,
+                std::optional<std::vector<uint8_t>> response) {
+    auto it = requests_.find(request_id);
+    if (it == requests_.end()) {
+      return;
+    }
+    DeviceCallback callback = std::move(it->second.callback);
+    requests_.erase(it);
+    GetState().pending.erase(request_id);
+    std::move(callback).Run(std::move(response));
+  }
+
+  // device::FidoDevice:
+  CancelToken DeviceTransact(std::vector<uint8_t> command,
+                             DeviceCallback callback) override {
+    RemoteWebAuthnState& state = GetState();
+    const CancelToken token = next_cancel_token_++;
+    const uint64_t request_id = state.next_request_id++;
+    requests_.emplace(request_id, Request{token, std::move(callback)});
+    state.pending.emplace(request_id, weak_factory_.GetWeakPtr());
+    // FidoDevice requires the callback to never run synchronously.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&RemoteFidoDevice::Dispatch, weak_factory_.GetWeakPtr(),
+                       request_id, std::move(command)));
+    return token;
+  }
+
+  void Cancel(CancelToken token) override {
+    for (const auto& [request_id, request] : requests_) {
+      if (request.token == token) {
+        RemoteWebAuthnState& state = GetState();
+        if (state.cancel_callback) {
+          state.cancel_callback.Run(request_id);
+        }
+        return;
+      }
+    }
+  }
+
+  std::string GetId() const override { return "remote-webauthn"; }
+
+  std::string GetDisplayName() const override { return "Remote authenticator"; }
+
+  device::FidoTransportProtocol DeviceTransport() const override {
+    return transport_;
+  }
+
+  base::WeakPtr<FidoDevice> GetWeakPtr() override {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  struct Request {
+    CancelToken token;
+    DeviceCallback callback;
+  };
+
+  void Dispatch(uint64_t request_id, std::vector<uint8_t> command) {
+    if (!requests_.contains(request_id)) {
+      return;
+    }
+    RemoteWebAuthnState& state = GetState();
+    if (!state.request_callback) {
+      Complete(request_id, std::nullopt);
+      return;
+    }
+    state.request_callback.Run(request_id, std::move(command));
+  }
+
+  const device::FidoTransportProtocol transport_;
+  base::flat_map<uint64_t, Request> requests_;
+  base::WeakPtrFactory<RemoteFidoDevice> weak_factory_{this};
+};
+
+// The remote client decides between its platform and roaming authenticators,
+// so the remote authenticator qualifies for every attachment and has no local
+// credential list to report.
+class RemoteFidoAuthenticator final : public device::FidoDeviceAuthenticator {
+ public:
+  explicit RemoteFidoAuthenticator(std::unique_ptr<RemoteFidoDevice> device)
+      : FidoDeviceAuthenticator(std::move(device)) {}
+
+  const device::AuthenticatorSupportedOptions& Options() const override {
+    options_ = FidoDeviceAuthenticator::Options();
+    options_.is_platform_device =
+        device::AuthenticatorSupportedOptions::PlatformDevice::kBoth;
+    return options_;
+  }
+
+  void GetPlatformCredentialInfoForRequest(
+      const device::CtapGetAssertionRequest& request,
+      const device::CtapGetAssertionOptions& options,
+      GetPlatformCredentialInfoForRequestCallback callback) override {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            std::move(callback),
+            std::vector<device::DiscoverableCredentialMetadata>(),
+            device::FidoRequestHandlerBase::RecognizedCredential::kUnknown));
+  }
+
+ private:
+  mutable device::AuthenticatorSupportedOptions options_;
+};
+
+class RemoteFidoDiscovery final : public device::FidoDeviceDiscovery {
+ public:
+  explicit RemoteFidoDiscovery(device::FidoTransportProtocol transport)
+      : FidoDeviceDiscovery(transport) {}
+
+ protected:
+  void StartInternal() override {
+    AddAuthenticator(std::make_unique<RemoteFidoAuthenticator>(
+        std::make_unique<RemoteFidoDevice>(transport())));
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&RemoteFidoDiscovery::NotifyDiscoveryStarted,
+                                  weak_factory_.GetWeakPtr(),
+                                  /*success=*/true));
+  }
+
+ private:
+  base::WeakPtrFactory<RemoteFidoDiscovery> weak_factory_{this};
+};
+
+class RemoteFidoDiscoveryFactory final : public device::FidoDiscoveryFactory {
+ public:
+  // Creates one discovery for the first of the USB or platform transports
+  // that the request allows, so the client sees each request once.
+  std::vector<std::unique_ptr<device::FidoDiscoveryBase>> Create(
+      device::FidoTransportProtocol transport) override {
+    std::vector<std::unique_ptr<device::FidoDiscoveryBase>> discoveries;
+    if (created_ ||
+        (transport != device::FidoTransportProtocol::kUsbHumanInterfaceDevice &&
+         transport != device::FidoTransportProtocol::kInternal)) {
+      return discoveries;
+    }
+    created_ = true;
+    discoveries.push_back(std::make_unique<RemoteFidoDiscovery>(transport));
+    return discoveries;
+  }
+
+  std::optional<std::unique_ptr<device::FidoDiscoveryBase>>
+  MaybeCreateEnclaveDiscovery() override {
+    return std::nullopt;
+  }
+
+#if BUILDFLAG(IS_WIN)
+  std::unique_ptr<device::FidoDiscoveryBase>
+  MaybeCreateWinWebAuthnApiDiscovery() override {
+    return nullptr;
+  }
+#endif
+
+ private:
+  bool created_ = false;
+};
+
+class RemoteAuthenticatorRequestDelegate final
+    : public AuthenticatorRequestClientDelegate {
+ public:
+  // The remote client performs account selection, so it normally returns a
+  // single assertion. Without browser UI, the first one is used otherwise.
+  void SelectAccount(
+      std::vector<device::AuthenticatorGetAssertionResponse> responses,
+      base::OnceCallback<void(device::AuthenticatorGetAssertionResponse)>
+          callback) override {
+    std::move(callback).Run(std::move(responses.at(0)));
+  }
+};
+
+}  // namespace
+
+bool IsRemoteWebAuthnEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kRemoteWebAuthnSwitch);
+}
+
+void SetRemoteWebAuthnHandler(RemoteWebAuthnRequestCallback request_callback,
+                              RemoteWebAuthnCancelCallback cancel_callback) {
+  RemoteWebAuthnState& state = GetState();
+  state.request_callback = std::move(request_callback);
+  state.cancel_callback = std::move(cancel_callback);
+  if (state.request_callback) {
+    return;
+  }
+  // Completing a request may destroy devices and change `pending`.
+  const auto pending = state.pending;
+  for (const auto& [request_id, device] : pending) {
+    if (device) {
+      device->Complete(request_id, std::nullopt);
+    }
+  }
+}
+
+bool RespondToRemoteWebAuthnRequest(uint64_t request_id,
+                                    std::vector<uint8_t> response) {
+  RemoteWebAuthnState& state = GetState();
+  auto it = state.pending.find(request_id);
+  if (it == state.pending.end() || !it->second) {
+    return false;
+  }
+  base::WeakPtr<RemoteFidoDevice> device = it->second;
+  device->Complete(request_id, response.empty()
+                                   ? std::nullopt
+                                   : std::make_optional(std::move(response)));
+  return true;
+}
+
+void SetRemoteWebAuthnPlatformAuthenticatorAvailable(bool available) {
+  GetState().platform_authenticator_available = available;
+}
+
+std::unique_ptr<device::FidoDiscoveryFactory> MakeRemoteFidoDiscoveryFactory() {
+  return std::make_unique<RemoteFidoDiscoveryFactory>();
+}
+
+std::unique_ptr<AuthenticatorRequestClientDelegate>
+MakeRemoteAuthenticatorRequestDelegate() {
+  return std::make_unique<RemoteAuthenticatorRequestDelegate>();
+}
+
+bool IsRemoteWebAuthnPlatformAuthenticatorAvailable() {
+  return GetState().platform_authenticator_available;
+}
+
+}  // namespace content
