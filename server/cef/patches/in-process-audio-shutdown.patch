+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_AUDIO_IN_PROCESS_AUDIO_SERVICE_H_
+#define CONTENT_BROWSER_AUDIO_IN_PROCESS_AUDIO_SERVICE_H_
+
+namespace content {
+
+// Destroys the in-process audio service if it runs on the current sequence.
+// The service borrows the browser's AudioManager, so it must go first;
+// otherwise it lives in sequence-local storage until scheduler teardown.
+void ShutDownInProcessAudioService();
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_AUDIO_IN_PROCESS_AUDIO_SERVICE_H_
